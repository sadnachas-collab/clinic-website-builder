DATABASE_URL="postgresql://gen_user:CHANGE_ME@192.168.0.5:5432/default_db"
DATABASE_SSL="true"
DATABASE_POOL_MAX="10"

S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_BUCKET="CHANGE_ME"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

SESSION_SECRET="generate-a-long-random-secret"
COOKIE_SECURE="true"

# Optional one-time bootstrap for a fresh database.
# Keep disabled in production after the first owner is created.
SEED_FIRST_ADMIN="false"
INITIAL_ADMIN_LOGIN=""
INITIAL_ADMIN_PASSWORD=""
